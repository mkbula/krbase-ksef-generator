{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@shared/*": ["src/shared/*"],
			"i18next": ["src/i18next.ts"]
		}
	},
	"files": ["src/index.ts"]
}
